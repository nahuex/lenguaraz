# Production profile: real Gemini engine behind a TLS reverse proxy (docs/deploy/production.md).
# cp examples/env/production.env .env  → fill GEMINI_API_KEY and ADMIN_TOKEN. Never commit .env.
ENGINE=gemini
GEMINI_API_KEY=
# Operator token for /admin: openssl rand -hex 32  (comments stay on their own lines: after an
# empty value an inline "# note" becomes the value in the developer path)
ADMIN_TOKEN=
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
STT_MODE=SMART
VAD_MODE=hybrid
SESSION_ROTATE_SECONDS=540
STT_STALL_SECONDS=20
PROGRESSIVE_TRANSLATION=true
# e.g. es — languages translated even with no listener, for the OBS overlay
ALWAYS_ON_LANGS=
AUTO_GLOSSARY=true
WS_MAX_CONN_PER_IP=200            # venue Wi-Fi often NATs everyone behind one address
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
STAGES_FILE=stages.yaml
BRANDING_FILE=branding.yaml
HOST=0.0.0.0
PORT=8000
# HTTPS (docs/deploy/production.md, section 3). Path A: your own certificate, paths as seen
# inside the container. Path B: the Caddy profile (docker compose --profile tls up -d).
# TLS_CERT_FILE=/app/certs/fullchain.pem
# TLS_KEY_FILE=/app/certs/privkey.pem
# DOMAIN=captions.example.org
# ACME_EMAIL=ops@example.org
# Proxy addresses whose X-Forwarded-* headers are trusted; * with the Caddy profile
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
