# Copy to .env and fill in. Never commit .env.
# gemini = real engine; fake = credential-free dry run (UI shows a DRY-RUN badge)
ENGINE=gemini
GEMINI_API_KEY=
ADMIN_TOKEN=change-me-long-random
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
GEMINI_INTERPRETER_MODEL=gemini-3.5-live-translate-preview
SESSION_ROTATE_SECONDS=540
STT_MODE=SMART
PROGRESSIVE_TRANSLATION=true
LOG_TRANSCRIPTS=false
REDIS_URL=

# --- HTTPS (docs/deploy/production.md section 3) ---------------------------------------
# Path A: your own certificate, terminated by Lenguaraz itself (https:// and wss:// on PORT).
# Both files or neither; PEM; put the full chain (leaf first) in the cert file. In Docker,
# uncomment the ./certs:/app/certs:ro mount in docker-compose.yml and use /app/certs/... paths.
# TLS_CERT_FILE=certs/dev-cert.pem
# TLS_KEY_FILE=certs/dev-key.pem
# Path B: automatic certificate with Caddy: docker compose --profile tls up -d
# DOMAIN = public DNS name of this host; ACME_EMAIL = Let's Encrypt account contact (optional,
# defaults to admin@DOMAIN). Set FORWARDED_ALLOW_IPS=* with this profile (see below).
# DOMAIN=captions.example.org
# ACME_EMAIL=ops@example.org
# Behind a proxy (Caddy above, nginx, Traefik, Cloud Run): trust X-Forwarded-* only from it, so
# the per-IP limit sees attendees, not the proxy. IPs or CIDRs, comma-separated; * = any.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
